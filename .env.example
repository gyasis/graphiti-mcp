# Graphiti MCP Server Environment Variables

# ======================
# Database Configuration
# ======================
FALKORDB_URI=redis://localhost:6379
FALKORDB_DATABASE=graphiti_memory

# ======================
# Azure OpenAI (Primary LLM — Tier 1)
# ======================
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=model-router
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ======================
# Tiered Fallback Configuration
# ======================
# The server uses a 3-tier fallback chain for LLM calls:
#   Tier 1: Primary model (set above as AZURE_OPENAI_DEPLOYMENT)
#   Tier 2: Azure non-reasoning fallback (fast, reliable JSON output)
#   Tier 3: Gemini cross-cloud fallback (resilience against Azure outages)
#
# WHY TIERED FALLBACK?
# Azure model-router may route to reasoning models (e.g., gpt-5-nano) that
# consume tokens on internal chain-of-thought BEFORE generating output.
# With insufficient max_tokens, all tokens go to reasoning and output is empty,
# causing json.loads('') failures. Tier 2 uses a non-reasoning model that
# outputs JSON directly without a reasoning tax.
#
# CHOOSING YOUR TIER 2 MODEL:
# Must be a non-reasoning model that supports json_schema response_format.
# Good choices: gpt-4.1-mini, gpt-4o-mini, gpt-4o
# Bad choices: gpt-5-nano, gpt-5-mini, o3, o4-mini (all reasoning models)
GRAPHITI_TIER2_MODEL=azure/gpt-4.1-mini

# Tier 3: Gemini (requires API key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
GRAPHITI_TIER3_MODEL=gemini/gemini-2.0-flash

# ======================
# Graphiti Configuration
# ======================
GRAPHITI_GROUP_ID=developer-your-username
USER_ID=your-username
